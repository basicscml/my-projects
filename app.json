{
  "expo": {
    "name": "Homebase",
    "slug": "homebase",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "homebase",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B4B8A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homebase.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.homebase.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B4B8A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#5B4B8A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Homebase to use the camera to scan product barcodes and read labels."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Homebase uses your location to remind you about your list when you arrive at a saved store."
        }
      ]
    ]
  }
}
